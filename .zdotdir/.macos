alias git=/opt/homebrew/bin/git
if [ -f "/opt/homebrew/bin/brew" ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# ---- editor is vs code ----
#  TODO: This should be in an install step

echo '#!/bin/bash\ncode --new-window --wait "$@"' > ~/.local/bin/edit
chmod a+x ~/.local/bin/edit
export EDITOR='emacs'  # Ideally code here too but edit doesn't work with busy for some reason


alias google-chrome="/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome"